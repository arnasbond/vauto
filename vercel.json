{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "git": {
    "deploymentEnabled": {
      "master": false
    }
  },
  "env": {
    "NEXT_PUBLIC_API_URL": "https://vauto-api.onrender.com",
    "NEXT_PUBLIC_APP_ORIGIN": "https://www.vauto.lt",
    "NEXT_PUBLIC_VAUTO_URL": "https://www.vauto.lt"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_API_URL": "https://vauto-api.onrender.com",
      "NEXT_PUBLIC_APP_ORIGIN": "https://www.vauto.lt",
      "NEXT_PUBLIC_VAUTO_URL": "https://www.vauto.lt"
    }
  },
  "rewrites": [
    {
      "source": "/download/vauto.apk",
      "destination": "https://github.com/arnasbond/vauto/releases/download/android-latest/vauto.apk"
    },
    {
      "source": "/download/vauto.vercel.apk",
      "destination": "https://github.com/arnasbond/vauto/releases/download/android-latest/vauto.apk"
    },
    {
      "source": "/og/:path*",
      "destination": "https://vauto-api.onrender.com/og/:path*"
    },
    {
      "source": "/listing/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Facebot|Twitterbot|TelegramBot|WhatsApp|Viber|Slackbot|Discordbot|LinkedInBot|Pinterest|Googlebot|bingbot|Applebot|Embedly|redditbot|SkypeUriPreview|vkShare|IA_Archiver).*"
        }
      ],
      "destination": "https://vauto-api.onrender.com/og/listing/:slug"
    },
    {
      "source": "/listing/:slug/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Facebot|Twitterbot|TelegramBot|WhatsApp|Viber|Slackbot|Discordbot|LinkedInBot|Pinterest|Googlebot|bingbot|Applebot|Embedly|redditbot|SkypeUriPreview|vkShare|IA_Archiver).*"
        }
      ],
      "destination": "https://vauto-api.onrender.com/og/listing/:slug"
    },
    {
      "source": "/listing",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Facebot|Twitterbot|TelegramBot|WhatsApp|Viber|Slackbot|Discordbot|LinkedInBot|Pinterest|Googlebot|bingbot|Applebot|Embedly|redditbot|SkypeUriPreview|vkShare|IA_Archiver).*"
        },
        {
          "type": "query",
          "key": "id",
          "value": "(?<lid>.+)"
        }
      ],
      "destination": "https://vauto-api.onrender.com/og/listing/:lid"
    },
    {
      "source": "/listing/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Facebot|Twitterbot|TelegramBot|WhatsApp|Viber|Slackbot|Discordbot|LinkedInBot|Pinterest|Googlebot|bingbot|Applebot|Embedly|redditbot|SkypeUriPreview|vkShare|IA_Archiver).*"
        },
        {
          "type": "query",
          "key": "id",
          "value": "(?<lid>.+)"
        }
      ],
      "destination": "https://vauto-api.onrender.com/og/listing/:lid"
    },
    {
      "source": "/listing",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Facebot|Twitterbot|TelegramBot|WhatsApp|Viber|Slackbot|Discordbot|LinkedInBot|Pinterest|Googlebot|bingbot|Applebot|Embedly|redditbot|SkypeUriPreview|vkShare|IA_Archiver).*"
        },
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>.+)"
        }
      ],
      "destination": "https://vauto-api.onrender.com/og/listing/:slug"
    },
    {
      "source": "/listing/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Facebot|Twitterbot|TelegramBot|WhatsApp|Viber|Slackbot|Discordbot|LinkedInBot|Pinterest|Googlebot|bingbot|Applebot|Embedly|redditbot|SkypeUriPreview|vkShare|IA_Archiver).*"
        },
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>.+)"
        }
      ],
      "destination": "https://vauto-api.onrender.com/og/listing/:slug"
    },
    {
      "source": "/api/vauto-agent",
      "destination": "https://vauto-api.onrender.com/api/vauto-agent"
    },
    {
      "source": "/api/vauto-agent/stream",
      "destination": "https://vauto-api.onrender.com/api/vauto-agent/stream"
    },
    {
      "source": "/api/chats/stream",
      "destination": "https://vauto-api.onrender.com/api/chats/stream"
    },
    {
      "source": "/api/chats/:path*",
      "destination": "https://vauto-api.onrender.com/api/chats/:path*"
    },
    {
      "source": "/api/vauto-agent/",
      "destination": "https://vauto-api.onrender.com/api/vauto-agent"
    },
    {
      "source": "/api/vauto-server",
      "destination": "https://vauto-api.onrender.com/api/vauto-server"
    },
    {
      "source": "/api/vauto-server/",
      "destination": "https://vauto-api.onrender.com/api/vauto-server"
    },
    {
      "source": "/api/ai/:path*",
      "destination": "https://vauto-api.onrender.com/api/ai/:path*"
    },
    {
      "source": "/api/search/vision",
      "destination": "https://vauto-api.onrender.com/api/search/vision"
    },
    {
      "source": "/api/search/vision/",
      "destination": "https://vauto-api.onrender.com/api/search/vision"
    },
    {
      "source": "/api/search/:path*",
      "destination": "https://vauto-api.onrender.com/api/search/:path*"
    },
    {
      "source": "/api/requirements",
      "destination": "https://vauto-api.onrender.com/api/requirements"
    },
    {
      "source": "/api/requirements/",
      "destination": "https://vauto-api.onrender.com/api/requirements"
    },
    {
      "source": "/listing/:slug",
      "destination": "/listing/index.html?slug=:slug"
    },
    {
      "source": "/listing/:slug/",
      "destination": "/listing/index.html?slug=:slug"
    },
    {
      "source": "/seller/:id",
      "destination": "/seller/index.html?id=:id"
    },
    {
      "source": "/seller/:id/",
      "destination": "/seller/index.html?id=:id"
    }
  ],
  "redirects": [
    {
      "source": "/admin/ai",
      "destination": "/admin/ai/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/download/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"vauto.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/profile/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/version-config.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/fashion/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/(.*)index.txt",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
