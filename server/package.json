{
  "name": "vauto-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "test:ai-foundation": "tsx --test src/ai/foundation/*.test.ts",
    "test:ai-intent": "tsx --test src/ai/intent/__tests__/*.test.ts",
    "test:ai-search": "tsx --test src/ai/search/__tests__/*.test.ts",
    "test:ai-sell": "tsx --test src/ai/sell/__tests__/*.test.ts",
    "test:ai-market": "tsx --test src/market-intelligence/__tests__/*.test.ts",
    "test:vauto-score": "tsx --test src/vauto-score/__tests__/*.test.ts",
    "test:buyer-match": "tsx --test src/buyer-match/__tests__/*.test.ts",
    "test:compare-engine": "tsx --test src/compare-engine/__tests__/*.test.ts",
    "test:ai-watch": "tsx --test src/ai-watch/__tests__/*.test.ts",
    "test:ai-red-team": "tsx --test src/ai/__tests__/full-red-team.test.ts",
    "test:stage10-integration": "tsx --test src/ai/__tests__/stage10-integration.test.ts",
    "test:stage10-http-integration": "tsx --test src/ai/__tests__/stage10-http-integration.test.ts",
    "test:transaction-state-machine": "tsx --test src/transaction/__tests__/state-machine.test.ts src/transaction/__tests__/transaction-integration.test.ts",
    "test:structured-offers": "tsx --test src/transaction/offers/__tests__/*.test.ts",
    "test:transaction-chat": "tsx --test src/transaction-chat/__tests__/*.test.ts",
    "test:negotiation-copilot": "tsx --test src/negotiation-copilot/__tests__/*.test.ts",
    "test:deal-room": "tsx --test src/deal-room/__tests__/*.test.ts",
    "test:real-postgres-pool": "tsx --test src/transaction/__tests__/real-postgres-pool.test.ts",
    "test:payment-ledger": "tsx --test src/payment/__tests__/payment-ledger.test.ts",
    "test:stripe-payment-intent": "tsx --test src/payments/stripe/__tests__/stripe-payment-intent.test.ts",
    "test:stripe-webhooks": "tsx --test src/payments/stripe/__tests__/stripe-webhooks.test.ts",
    "test:funds-transfer": "tsx --test src/payments/transfer/__tests__/funds-transfer.test.ts",
    "test:financial-reconciliation": "tsx --test src/payments/__tests__/financial-reconciliation.test.ts src/payments/__tests__/red-team-financial.test.ts src/payments/__tests__/real-postgres-financial.test.ts",
    "test:delivery-shipping": "tsx --test src/delivery/__tests__/delivery-shipping.test.ts",
    "test:dispute-resolution": "tsx --test src/disputes/__tests__/dispute-resolution.test.ts",
    "test:reputation-engine": "tsx --test src/reputation/__tests__/reputation-engine.test.ts",
    "seed": "tsx src/seed.ts",
    "e2e:simulate": "tsx src/test/vauto-e2e-simulation.ts",
    "setup-stripe": "tsx scripts/setup-stripe.ts",
    "test:visual-pipeline-qa": "npm run build && node scripts/run-visual-pipeline-qa.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-textract": "^3.1077.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.4.0",
    "google-auth-library": "^10.9.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.4",
    "pg": "^8.13.3",
    "sharp": "^0.34.3",
    "stripe": "^17.7.0",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tsconfig/node22": "^22.0.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.21",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
